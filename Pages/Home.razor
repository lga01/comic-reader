@page "/"
@inject IJSRuntime JS

<div class="reader-app">
    @if (!signedIn)
    {
        <div class="library-empty">
            <h1>Mi lector de cómics V2</h1>
            <p>Conecta tu cuenta de Google Drive para ver tus cómics</p>
            <button class="btn-primary" @onclick="SignIn">Conectar con Google Drive</button>
            @if (signInError != null)
            {
                <p class="error-msg">@signInError</p>
            }
        </div>
    }
    else if (currentComic == null)
    {
        <div class="library">
            <div class="library-header">
                <h1>Mi biblioteca</h1>
                <button class="btn-secondary" @onclick="LoadComics">Actualizar lista</button>
            </div>
            @if (loadingLibrary)
            {
                <p>Cargando cómics...</p>
            }
            else if (categories.Count == 0)
            {
                <p>No se encontraron archivos .cbz en tu Drive.</p>
            }
            else
            {
                <ul class="comic-list">
                    @foreach (var category in categories)
                    {
                        <details class="comic-folder">
                            <summary>
                                📁 @category.Name (@category.Comics.Count)
                            </summary>

                            @if (category.Comics.Count == 0)
                            {
                                <p class="empty-folder">No hay cómics.</p>
                            }
                            else
                            {
                                <ul class="comic-list">
                                    @foreach (var comic in category.Comics)
                                    {
                                        <li class="comic-row">
                                            <span class="comic-name" @onclick="() => OpenComic(category, comic)">
                                                📖 @comic.Name
                                            </span>
                                            <span class="comic-status">
                                                @if (comic.Leido)
                                                {
                                                    <span class="badge badge-leido">✓ Leído</span>
                                                }
                                                else if (comic.Pagina != null && comic.TotalPaginas != null)
                                                {
                                                    <span class="badge badge-progreso">@(comic.Pagina + 1)/@comic.TotalPaginas</span>
                                                }
                                                <button class="btn-toggle" @onclick="() => ToggleRead(category, comic)" title="Marcar leído/no leído">
                                                    @(comic.Leido ? "↺" : "✓")
                                                </button>
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                        </details>
                    }
                </ul>
            }
        </div>
    }
    else
    {
        <div class="reader" id="reader-container" tabindex="0" @onkeydown="HandleKeyDown">
            <div class="reader-toolbar">
                <button @onclick="CloseComic">← Biblioteca</button>
                <span>@currentComic.Name (@(pageUrls.Count > 0 ? currentPage + 1 : 0) / @pageUrls.Count)</span>
                <span class="zoom-controls">
                    <button @onclick="ZoomOut" title="Alejar">−</button>
                    <button @onclick="ResetZoom" title="Restablecer zoom">@((int)(zoom * 100))%</button>
                    <button @onclick="ZoomIn" title="Acercar">+</button>
                    <button @onclick="ToggleFullscreen" title="Pantalla completa">⛶</button>
                </span>
            </div>
            <div class="reader-page"
                 @onwheel="OnWheel" @onwheel:preventDefault="true"
                 @onmousedown="OnMouseDown"
                 @onmousemove="OnMouseMove"
                 @onmouseup="OnMouseUp"
                 @onmouseleave="OnMouseLeave"
                 @ondblclick="OnDoubleClick">
                @if (pageUrls.Count > 0)
                {
                    <img src="@pageUrls[currentPage]" alt="página @(currentPage + 1)"
                         draggable="false"
                         style="transform: scale(@zoom.ToString(System.Globalization.CultureInfo.InvariantCulture)) translate(@(panX.ToString(System.Globalization.CultureInfo.InvariantCulture))px, @(panY.ToString(System.Globalization.CultureInfo.InvariantCulture))px); cursor: @(zoom > 1 ? (isDragging ? "grabbing" : "grab") : "pointer");" />
                }
                else
                {
                    <p>Cargando...</p>
                }
            </div>
            <div class="reader-nav">
                <button @onclick="PrevPage" disabled="@(currentPage == 0)">‹ Anterior</button>
                <button @onclick="NextPage" disabled="@(currentPage >= pageUrls.Count - 1)">Siguiente ›</button>
            </div>
        </div>
    }
</div>

@code {
    private class ComicCategory
    {
        public string FolderId { get; set; } = "";
        public string Name { get; set; } = "";
        public List<ComicInfo> Comics { get; set; } = [];
    }

    private class ComicInfo
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public bool Leido { get; set; }
        public int? Pagina { get; set; }
        public int? TotalPaginas { get; set; }
    }

    private List<ComicCategory> categories = [];

    private bool signedIn;
    private string? signInError;
    private bool loadingLibrary;

    private ComicCategory? currentCategory;
    private ComicInfo? currentComic;
    private List<string> pageUrls = new();
    private int currentPage;

    // Zoom y arrastre
    private double zoom = 1.0;
    private double panX = 0;
    private double panY = 0;
    private bool isDragging;
    private bool hasDragged;
    private double dragStartX, dragStartY;
    private double dragStartPanX, dragStartPanY;

    private const double ZoomStep = 0.25;
    private const double ZoomMin = 1.0;
    private const double ZoomMax = 4.0;

    private void ResetZoomState()
    {
        zoom = 1.0;
        panX = 0;
        panY = 0;
    }

    private void ZoomIn()
    {
        zoom = Math.Min(ZoomMax, Math.Round(zoom + ZoomStep, 2));
    }

    private void ZoomOut()
    {
        zoom = Math.Max(ZoomMin, Math.Round(zoom - ZoomStep, 2));
        if (zoom <= ZoomMin) { panX = 0; panY = 0; }
    }

    private void ResetZoom() => ResetZoomState();

    private void OnWheel(WheelEventArgs e)
    {
        if (e.DeltaY < 0) ZoomIn();
        else ZoomOut();
    }

    private void OnDoubleClick()
    {
        if (zoom > ZoomMin) ResetZoomState();
        else zoom = 2.0;
    }

    private void OnMouseDown(MouseEventArgs e)
    {
        isDragging = true;
        hasDragged = false;
        dragStartX = e.ClientX;
        dragStartY = e.ClientY;
        dragStartPanX = panX;
        dragStartPanY = panY;
    }

    private void OnMouseMove(MouseEventArgs e)
    {
        if (!isDragging) return;

        var dx = e.ClientX - dragStartX;
        var dy = e.ClientY - dragStartY;

        if (Math.Abs(dx) > 3 || Math.Abs(dy) > 3) hasDragged = true;

        if (zoom > ZoomMin)
        {
            // Dividimos por zoom para que el arrastre siga el ratón 1:1 en pantalla
            panX = dragStartPanX + dx / zoom;
            panY = dragStartPanY + dy / zoom;
        }
    }

    private async Task OnMouseUp(MouseEventArgs e)
    {
        var wasDragging = isDragging;
        isDragging = false;

        // Si no hubo arrastre real, se trata como un click normal para pasar página
        if (wasDragging && !hasDragged && zoom <= ZoomMin)
        {
            await NextPage();
        }
    }

    private void OnMouseLeave()
    {
        isDragging = false;
    }

    private async Task ToggleFullscreen()
    {
        await JS.InvokeAsync<bool>("readerUtils.toggleFullscreen", "reader-container");
    }

    private async Task SignIn()
    {
        signInError = null;
        try
        {
            await JS.InvokeVoidAsync("driveAuth.signIn");
            signedIn = true;
            await LoadComics();
        }
        catch
        {
            signInError = "No se pudo conectar con Google. Inténtalo de nuevo.";
        }
    }

    private async Task LoadComics()
    {
        try
        {
            loadingLibrary = true;
            StateHasChanged();

            categories = await JS.InvokeAsync<List<ComicCategory>>(
                "driveAuth.listComicsByCategory");

            loadingLibrary = false;
            StateHasChanged();
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
            loadingLibrary = false;
        }
    }

    private async Task OpenComic(ComicCategory category, ComicInfo comic)
    {
        currentCategory = category;
        currentComic = comic;
        pageUrls.Clear();
        currentPage = 0;
        ResetZoomState();
        StateHasChanged();

        var urls = await JS.InvokeAsync<string[]>("driveAuth.openComic", comic.Id);
        pageUrls = urls.ToList();

        // Si ya había progreso guardado, retomamos esa página
        currentPage = (comic.Pagina != null && comic.Pagina < pageUrls.Count) ? comic.Pagina.Value : 0;

        StateHasChanged();
    }

    private void CloseComic()
    {
        currentCategory = null;
        currentComic = null;
        pageUrls.Clear();
        currentPage = 0;
        ResetZoomState();
    }

    private async Task NextPage()
    {
        if (currentPage < pageUrls.Count - 1)
        {
            currentPage++;
            ResetZoomState();
            await SaveProgress();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 0)
        {
            currentPage--;
            ResetZoomState();
            await SaveProgress();
        }
    }

    private async Task SaveProgress()
    {
        // Capturamos referencias locales ANTES del await: si el usuario cierra
        // el cómic o cambia de página muy rápido mientras esta llamada está en
        // marcha, currentCategory/currentComic pueden pasar a null mientras
        // esperamos la respuesta. Usando variables locales evitamos que eso
        // provoque un NullReferenceException al continuar después del await.
        var category = currentCategory;
        var comic = currentComic;
        var page = currentPage;
        var total = pageUrls.Count;

        if (category == null || comic == null) return;

        await JS.InvokeVoidAsync("driveAuth.saveComicPage",
            category.FolderId, comic.Name, page, total);

        // Reflejamos el cambio también en memoria, para que la biblioteca
        // muestre el estado correcto al volver, sin tener que recargar
        comic.Pagina = page;
        comic.TotalPaginas = total;
        comic.Leido = (page + 1) >= total;
    }

    private async Task ToggleRead(ComicCategory category, ComicInfo comic)
    {
        var nuevoEstado = !comic.Leido;
        await JS.InvokeVoidAsync("driveAuth.setComicRead", category.FolderId, comic.Name, nuevoEstado);

        // Actualizamos el estado en memoria, sin recargar toda la lista desde Drive
        comic.Leido = nuevoEstado;
        if (nuevoEstado && comic.TotalPaginas.HasValue)
        {
            comic.Pagina = comic.TotalPaginas.Value - 1;
        }
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight") await NextPage();
        else if (e.Key == "ArrowLeft") await PrevPage();
    }
}
